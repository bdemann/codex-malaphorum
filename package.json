    "description": "A personal PWA for tracking hand-crafted malaphors and the idiom library they're built from.",
    "keywords": [],
    "license": "(MIT OR CC0-1.0)",
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
